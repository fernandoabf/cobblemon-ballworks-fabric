{
  "schemaVersion": 1,
  "id": "cobbleballworks",
  "version": "${version}",
  "name": "Cobblemon Ballworks",
  "description": "Pixelmon-style Poké Ball forging for Cobblemon: apricorn discs, hand anvil + hammers, Mechanical Anvil. Fabric 1.21.1 port of Cobblemon Ballworks, originally written for Forge 1.20.1 by xaiver (cxaiverb).",
  "authors": [
    "xaiver (cxaiverb) - original Forge mod"
  ],
  "contributors": [
    "fernandoabf - Fabric 1.21.1 port"
  ],
  "contact": {
    "homepage": "https://github.com/fernandoabf/cobblemon-ballworks-fabric",
    "sources": "https://github.com/fernandoabf/cobblemon-ballworks-fabric",
    "issues": "https://github.com/fernandoabf/cobblemon-ballworks-fabric/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.xaiver.cobbleballworks.CobbleBallworks"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.xaiver.cobbleballworks.client.CobbleBallworksClient"
      }
    ],
    "emi": [
      "com.xaiver.cobbleballworks.client.compat.emi.BallworksEmiPlugin"
    ]
  },
  "mixins": [
    "cobbleballworks.mixins.json"
  ],
  "depends": {
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.0",
    "cobblemon": ">=1.8.0"
  },
  "suggests": {
    "emi": "*"
  }
}
